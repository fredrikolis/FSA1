# v1 date/time batch: DATE YEAR MONTH DAY EDATE DATEDIF TODAY NOW, extended with the ISO-date-TEXT
# batch: HOUR MINUTE SECOND NETWORKDAYS.
#
# EPOCH: the Excel 1900 date-serial system, WITH Excel's 1900 leap-year bug replicated (serial 60 =
# the fictional 1900-02-29; serials >= 61 shift back one day, so 44927 = 2023-01-01). The serial<->date
# maps are single-sourced: the forward `serial_to_ymd` in func::text (TEXT's date render needs it), its
# inverse `serial_from_ymd` in func/date.rs. TODAY/NOW are VOLATILE and read the
# resolver's INJECTABLE clock, PINNED in conformance to 2023-01-01T12:00:00 = serial 44927.5
# (fsa1_ast::PINNED_NOW_SERIAL) so every fixture is reproducible.
#
# EXPECTED values are derived INDEPENDENTLY of FSA1 by a standalone python3 model of the Excel
# date semantics (proleptic-Gregorian via date.toordinal(), Excel serial = toordinal - 693594 for
# dates on/after 1900-03-01; cross-checked against the well-known anchor 44927 = 2023-01-01) — NEVER
# by running FSA1 (see PROVENANCE.md).
#
# python3 model output (authoring run):
#   DATE(2023,1,1)=44927 · DATE(2008,14,2)=39846 · DATE(108,1,2)=39449 · DATE(2023,3,0)=44985
#   DATE(10000,1,1)=#NUM! · DATE(2020,1,31)=43861 · DATE(2020,1,1)=43831 · DATE(2023,6,1)=45078
#   serial 44927 -> (2023,1,1) · serial 44957 -> (2023,1,31) · serial 60 -> phantom 1900-02-29
#   YEAR(44927)=2023 · MONTH(44927)=1 · DAY(44957)=31 · YEAR(60)=1900 · MONTH(60)=2 · DAY(60)=29
#   EDATE(44927,1)=44958 (2023-02-01) · EDATE(43861,1)=43890 (2020-02-29, clamped) ·
#   EDATE(44927,-2)=44866 (2022-11-01)
#   DATEDIF(44927,44957,"D")=30 · DATEDIF(43831,45078,"Y")=3 · DATEDIF(43831,45078,"M")=41
#   DATEDIF(43845,43910,"MD")=5 · DATEDIF(43845,45097,"YM")=5 · DATEDIF(43845,45005,"YD")=65
#   DATEDIF(44957,44927,"D")=#NUM! (start>end) · DATEDIF(44927,44957,"Q")=#NUM! (bad unit)
#   TODAY()=44927 (floor 44927.5) · NOW()=44927.5 · NOW()-TODAY()=0.5
#   (serials for the DATEDIF fixtures: DATE(2020,1,1)=43831, DATE(2023,6,1)=45078,
#    DATE(2020,1,15)=43845, DATE(2020,3,20)=43910, DATE(2023,6,20)=45097, DATE(2023,3,20)=45005)
#
# The Excel-semantics calls pinned here:
#   * DATE truncates its args toward zero and NORMALIZES an out-of-range month/day (roll-over), folding
#     a year 0..=1899 by +1900; a year outside 0..=9999 or a result outside [1,2958465] is #NUM!.
#   * YEAR/MONTH/DAY floor the serial and read it through the leap-bug-faithful mapping (serial 60 =
#     1900-02-29); a serial < 1 is #NUM!.
#   * EDATE adds whole months and CLAMPS the day to the target month's last day.
#   * DATEDIF "Y"/"M"/"D" are complete years/months/days; "MD"/"YM"/"YD" are the remainders; the unit
#     folds case; start>end and an unknown unit are #NUM!.
#   * TODAY floors the pinned clock to an integer serial; NOW keeps the time-of-day fraction.
#
# ISO-DATE-TEXT EXTENSION. Excel reads a DATE STRING in a date argument as that date's serial, and a
# `yyyy-mm-dd hh:mm[:ss]` string's clock as the serial's FRACTIONAL part; text that is not a date is
# #VALUE!. HOUR/MINUTE/SECOND read that fraction, so they answer off a bare fraction too. NETWORKDAYS
# counts the days start..end inclusive that are neither Sat/Sun nor a listed holiday, and the holidays
# argument is a date argument like any other. EXPECTED values from the same standalone python3 model,
# extended for these (scratch: datetext_oracle.py) — NEVER by running FSA1. Its authoring run printed:
#
#   anchor: serial(2023,1,1)=44927 · serial(2026,8,3)=46237 · serial(2026,8,5)=46239
#           serial(2026,8,7)=46241 · 2026-08-03..07 = Mon Tue Wed Thu Fri
#   YEAR("2026-08-07")=2026 · MONTH("2026-08-07")=8 · DAY("2026-08-07")=7 · YEAR("banana")=#VALUE!
#   HOUR("2026-08-07 13:45")=13 · MINUTE("2026-08-07 13:45")=45 · SECOND("2026-08-07 13:45:09")=9
#   HOUR(0.5)=12 · MINUTE(0.5)=0 · SECOND(0.5)=0
#   NETWORKDAYS("2026-08-03","2026-08-07")=5 · with holiday "2026-08-05" = 4 · "banana" = #VALUE!
#
# NOT pinned here: `YEAR("8/7/2026")`, which Excel answers 2026 and FSA1 refuses. The corpus is the
# ORACLE, so a locale date parser is a Diverge to be FIXED, never an expectation authored to #VALUE!.

# ---- DATE(year, month, day) ----

[date-basic]
funcs: DATE
formula: =DATE(2023, 1, 1)
expect: 44927

[date-normalizes-month-rollover]
funcs: DATE
formula: =DATE(2008, 14, 2)
expect: 39846

[date-day-zero-rolls-back]
funcs: DATE
formula: =DATE(2023, 3, 0)
expect: 44985

[date-two-digit-year-rule]
funcs: DATE
formula: =DATE(108, 1, 2)
expect: 39449

[date-year-past-9999-is-num-error]
funcs: DATE
formula: =DATE(10000, 1, 1)
expect: #NUM!

# ---- YEAR / MONTH / DAY (read a serial) ----

[year-basic]
funcs: YEAR
formula: =YEAR(44927)
expect: 2023

[year-leap-bug-phantom]
funcs: YEAR
formula: =YEAR(60)
expect: 1900

[year-before-epoch-is-num-error]
funcs: YEAR
formula: =YEAR(0)
expect: #NUM!

[month-basic]
funcs: MONTH
formula: =MONTH(44927)
expect: 1

[month-leap-bug-phantom]
funcs: MONTH
formula: =MONTH(60)
expect: 2

[month-of-a-cell-serial]
funcs: MONTH
cell A1: 45078
formula: =MONTH(A1)
expect: 6

[day-end-of-month]
funcs: DAY
formula: =DAY(44957)
expect: 31

[day-leap-bug-phantom]
funcs: DAY
formula: =DAY(60)
expect: 29

[day-non-numeric-is-value-error]
funcs: DAY
formula: =DAY("nope")
expect: #VALUE!

# ---- EDATE(start_date, months) ----

[edate-one-month-forward]
funcs: EDATE
formula: =EDATE(44927, 1)
expect: 44958

[edate-clamps-to-end-of-month]
funcs: EDATE
formula: =EDATE(43861, 1)
expect: 43890

[edate-negative-months]
funcs: EDATE
formula: =EDATE(44927, -2)
expect: 44866

[edate-non-numeric-start-is-value-error]
funcs: EDATE
formula: =EDATE("x", 1)
expect: #VALUE!

# ---- DATEDIF(start_date, end_date, unit) ----

[datedif-days]
funcs: DATEDIF
formula: =DATEDIF(44927, 44957, "D")
expect: 30

[datedif-complete-years]
funcs: DATEDIF
formula: =DATEDIF(43831, 45078, "Y")
expect: 3

[datedif-complete-months]
funcs: DATEDIF
formula: =DATEDIF(43831, 45078, "M")
expect: 41

[datedif-md-day-remainder]
funcs: DATEDIF
formula: =DATEDIF(43845, 43910, "MD")
expect: 5

[datedif-ym-month-remainder]
funcs: DATEDIF
formula: =DATEDIF(43845, 45097, "YM")
expect: 5

[datedif-yd-day-of-year-remainder]
funcs: DATEDIF
formula: =DATEDIF(43845, 45005, "YD")
expect: 65

[datedif-unit-folds-case]
funcs: DATEDIF
formula: =DATEDIF(44927, 44957, "d")
expect: 30

[datedif-start-after-end-is-num-error]
funcs: DATEDIF
formula: =DATEDIF(44957, 44927, "D")
expect: #NUM!

[datedif-unknown-unit-is-num-error]
funcs: DATEDIF
formula: =DATEDIF(44927, 44957, "Q")
expect: #NUM!

# ---- TODAY() / NOW() — VOLATILE, reading the PINNED clock (44927.5 = 2023-01-01T12:00) ----

[today-pinned]
funcs: TODAY
formula: =TODAY()
expect: 44927

[today-is-a-number-usable-in-arithmetic]
funcs: TODAY
formula: =TODAY()+1
expect: 44928

[now-pinned]
funcs: NOW
formula: =NOW()
expect: 44927.5

[now-minus-today-is-the-time-fraction]
funcs: NOW, TODAY
formula: =NOW()-TODAY()
expect: 0.5

# ---- An ISO DATE STRING is a date, in every date argument ----

[year-of-iso-date-text]
funcs: YEAR
note: the reported gap -- a date argument reads a `yyyy-mm-dd` string as its serial, as Excel does.
formula: =YEAR("2026-08-07")
expect: 2026

[month-of-iso-date-text]
funcs: MONTH
formula: =MONTH("2026-08-07")
expect: 8

[day-of-iso-date-text]
funcs: DAY
formula: =DAY("2026-08-07")
expect: 7

[year-of-non-date-text-is-value-error]
funcs: YEAR
note: reading a DATE string widens what a date argument accepts; it coerces nothing else.
formula: =YEAR("banana")
expect: #VALUE!

# ---- HOUR / MINUTE / SECOND (the serial's FRACTIONAL part) ----

[hour-of-iso-datetime-text]
funcs: HOUR
note: the clock SURVIVES the read -- a whole-day reading of the same string would answer 0.
formula: =HOUR("2026-08-07 13:45")
expect: 13

[minute-of-iso-datetime-text]
funcs: MINUTE
formula: =MINUTE("2026-08-07 13:45")
expect: 45

[second-of-iso-datetime-text]
funcs: SECOND
formula: =SECOND("2026-08-07 13:45:09")
expect: 9

[hour-of-a-bare-serial-fraction]
funcs: HOUR
note: a fraction below 1 is a time-of-day, NOT an out-of-band date serial: half a day is 12:00.
formula: =HOUR(0.5)
expect: 12

[minute-of-a-bare-serial-fraction]
funcs: MINUTE
formula: =MINUTE(0.5)
expect: 0

[second-of-a-bare-serial-fraction]
funcs: SECOND
formula: =SECOND(0.5)
expect: 0

# ---- NETWORKDAYS(start_date, end_date, [holidays]) — the holidays argument is a date argument ----

[networkdays-iso-text-full-workweek]
funcs: NETWORKDAYS
note: 2026-08-03..07 is Mon..Fri -- five workdays, the baseline the holiday case is read against.
formula: =NETWORKDAYS("2026-08-03","2026-08-07")
expect: 5

[networkdays-iso-text-holiday-excluded]
funcs: NETWORKDAYS
note: the Wednesday is excluded, so arg 3 read the string that args 1 and 2 read.
formula: =NETWORKDAYS("2026-08-03","2026-08-07","2026-08-05")
expect: 4

[networkdays-non-date-text-holiday-is-value-error]
funcs: NETWORKDAYS
formula: =NETWORKDAYS("2026-08-03","2026-08-07","banana")
expect: #VALUE!
