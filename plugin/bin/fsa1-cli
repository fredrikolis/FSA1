#!/usr/bin/env bash
# Concern: resolves this machine's fsa1-cli — cached, downloaded or built — and execs it | Non-concern: what the binary does, cross-building the release assets | IO: (argv, env) -> exec fsa1-cli
#
# Why a launcher and not the binary itself: a Claude plugin's bin/ is shared across every host the
# plugin runs on — Cowork's Linux cloud sandbox AND Claude Code on the user's own macOS / Windows /
# Linux desktop. A compiled Rust binary is per-(os,arch), so this script picks (or produces) the
# matching one and caches it in ${CLAUDE_PLUGIN_DATA} (a persistent dir that survives plugin updates;
# ${CLAUDE_PLUGIN_ROOT} changes every update, so we never cache under it).
#
# Resolution order (first hit wins), all overridable:
#   1. $FSA1_CLI_BIN                       — explicit path to a binary (dev / power users)
#   2. cached binary in $DATA/bin          — produced by a previous run
#   3. bundled prebuilt in $ROOT/dist/...  — shipped in the repo for this (os,arch)
#   4. local dev build $ROOT/target/...    — release or debug, for contributors
#   5. GitHub Release asset (downloaded)   — the normal path once the repo is public
#   6. build from source with cargo        — last resort, needs a Rust toolchain
set -euo pipefail

# --- locate the plugin root (works even if the path vars are unset, e.g. run directly) -------------
ROOT="${CLAUDE_PLUGIN_ROOT:-}"
if [ -z "${ROOT}" ]; then
  # bin/ sits at the plugin root; resolve relative to this script.
  ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi
DATA="${CLAUDE_PLUGIN_DATA:-${XDG_DATA_HOME:-${HOME}/.local/share}/fsa1-plugin}"

# Where releases live once this repo is public. Override with FSA1_RELEASE_REPO=owner/name.
RELEASE_REPO="${FSA1_RELEASE_REPO:-fredrikolis/FSA1}"

# --- detect (os, arch) and derive names ------------------------------------------------------------
uname_s="$(uname -s 2>/dev/null || echo unknown)"
uname_m="$(uname -m 2>/dev/null || echo unknown)"

case "${uname_s}" in
  Linux)                      OS="linux"   ; EXT="" ;;
  Darwin)                     OS="macos"   ; EXT="" ;;
  MINGW*|MSYS*|CYGWIN*|Windows_NT) OS="windows" ; EXT=".exe" ;;
  *) echo "fsa1-cli launcher: unsupported OS '${uname_s}'" >&2; exit 70 ;;
esac
case "${uname_m}" in
  x86_64|amd64)   ARCH="x86_64" ;;
  arm64|aarch64)  ARCH="aarch64" ;;
  *) echo "fsa1-cli launcher: unsupported arch '${uname_m}'" >&2; exit 70 ;;
esac

SLUG="${OS}-${ARCH}"                 # e.g. linux-x86_64, macos-aarch64, windows-x86_64
BIN="fsa1-cli${EXT}"
ASSET="fsa1-cli-${SLUG}${EXT}"       # release asset name (matches .github/workflows/plugin-release.yml)
CACHE="${DATA}/bin/${BIN}"

log() { echo "fsa1-cli launcher: $*" >&2; }   # never pollute stdout — that is the tool's output

# --- 1. explicit override --------------------------------------------------------------------------
if [ -n "${FSA1_CLI_BIN:-}" ] && [ -x "${FSA1_CLI_BIN}" ]; then
  exec "${FSA1_CLI_BIN}" "$@"
fi

# --- 2. cached binary ------------------------------------------------------------------------------
if [ -x "${CACHE}" ]; then
  exec "${CACHE}" "$@"
fi

install_to_cache() {
  # $1 = source binary path
  mkdir -p "${DATA}/bin"
  cp "$1" "${CACHE}"
  chmod +x "${CACHE}" 2>/dev/null || true
}

# --- 3. bundled prebuilt shipped in the repo -------------------------------------------------------
BUNDLED="${ROOT}/dist/${SLUG}/${BIN}"
if [ -x "${BUNDLED}" ] || [ -f "${BUNDLED}" ]; then
  log "using bundled binary for ${SLUG}"
  install_to_cache "${BUNDLED}"
  exec "${CACHE}" "$@"
fi

# --- 4. local dev build (contributors working in the repo) -----------------------------------------
for prof in release debug; do
  DEV="${ROOT}/target/${prof}/${BIN}"
  if [ -x "${DEV}" ] || [ -f "${DEV}" ]; then
    log "using local ${prof} build"
    exec "${DEV}" "$@"
  fi
done

# --- 5. download the release asset (normal path for an installed, public plugin) -------------------
download() {
  # $1 = url, $2 = dest
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$2" "$1"
  else
    return 1
  fi
}
if [ -n "${RELEASE_REPO}" ]; then
  URL="https://github.com/${RELEASE_REPO}/releases/latest/download/${ASSET}"
  TMP="${DATA}/bin/.${BIN}.download"
  mkdir -p "${DATA}/bin"
  if download "${URL}" "${TMP}"; then
    mv "${TMP}" "${CACHE}"
    chmod +x "${CACHE}" 2>/dev/null || true
    log "downloaded ${ASSET} from ${RELEASE_REPO} releases"
    exec "${CACHE}" "$@"
  else
    rm -f "${TMP}" 2>/dev/null || true
    log "no release asset ${ASSET} (repo private or not yet released); trying to build"
  fi
fi

# --- 6. build from source (needs a Rust toolchain) -------------------------------------------------
if command -v cargo >/dev/null 2>&1 && [ -f "${ROOT}/Cargo.toml" ]; then
  log "building fsa1-cli from source (first run; needs Rust) ..."
  # Build into DATA so the artifact persists across plugin updates and ROOT stays read-only-ish.
  if CARGO_TARGET_DIR="${DATA}/target" cargo build --release -p fsa1-cli \
        --manifest-path "${ROOT}/Cargo.toml" >&2; then
    BUILT="${DATA}/target/release/${BIN}"
    if [ -f "${BUILT}" ]; then
      install_to_cache "${BUILT}"
      exec "${CACHE}" "$@"
    fi
  fi
  log "build failed"
fi

# --- nothing worked --------------------------------------------------------------------------------
cat >&2 <<EOF
fsa1-cli launcher: could not obtain a native binary for ${SLUG}.
Tried: \$FSA1_CLI_BIN, cache (${CACHE}), bundled dist/, local target/, GitHub releases, cargo build.
Fixes:
  - Make the plugin repo public and publish a release with asset '${ASSET}', OR
  - Install a Rust toolchain (https://rustup.rs) so it can build from source, OR
  - Point \$FSA1_CLI_BIN at a prebuilt fsa1-cli binary.
EOF
exit 70
