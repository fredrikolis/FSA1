#!/usr/bin/env bash
# pre-commit gate: formatting + lint + annotations (all sub-second), then the conformance backslide
# state-guard.
#
# After the fast checks, the conformance BACKSLIDE state-guard runs unconditionally — the `conformance`
# crate exists and the guard is live (see the clearly-marked block below that grades the formula corpus
# via `cargo run -p conformance -- backslide`). The full test gate
# (`cargo test --workspace -- --include-ignored`) remains a deliberate, observed step — intentionally
# NOT run here, so it never gets chained into the commit action.
# Enable this hook per clone: git config core.hooksPath .githooks
set -euo pipefail

# git hooks run with a minimal environment; the Rust toolchain is often not on PATH (a GUI/IDE git
# client, a cron/CI shell, or any non-login shell). Resolve `cargo` robustly regardless of the invoking
# shell: cargo always installs its binary under $CARGO_HOME/bin (default ~/.cargo/bin), so prepend that
# directly to PATH — this works even when ~/.cargo/env does not exist (a non-rustup install, a custom
# CARGO_HOME). The env script, when present, is sourced too (it sets up other rustup vars). Fail loud
# with a clear message if cargo still cannot be found (never silently skip the gate).
cargo_home="${CARGO_HOME:-$HOME/.cargo}"
case ":$PATH:" in
	*":$cargo_home/bin:"*) ;;                 # already present — don't duplicate
	*) PATH="$cargo_home/bin:$PATH" ;;
esac
export PATH
[ -f "$cargo_home/env" ] && . "$cargo_home/env"
command -v cargo >/dev/null 2>&1 || {
	echo "pre-commit: cargo not found (looked in $cargo_home/bin; install rustup or set CARGO_HOME)" >&2
	exit 1
}

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check

echo "pre-commit: cargo clippy -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

# annotated-tree annotation + architecture gate (sub-second; rules live in ./.annotated-tree.toml).
# Three frozen CORPORA are graduated CONTRACTS, not authored source, so they are excluded here:
#   -I 'conformance/encoding/**'   the W1 encoding corpus (conformance/encoding/, its PROVENANCE.md)
#   -I 'conformance/formula/**'    the W3 formula-conformance corpus (.fixtures probes, PROVENANCE.md,
#                                  MANIFEST.sha256, facts-snapshot.tsv) — the conformance crate's OWN
#                                  src/**/ and tests/**/ stay annotated (they are authored code).
#   -I 'conformance/render/**'     the W4 rendered-VALUE oracles (oracle/**, PROVENANCE.md,
#                                  MANIFEST.sha256, facts-snapshot.tsv) — charlie-model's OWN
#                                  tests/render_conformance.rs stays annotated (it is authored code).
# Keep these globs in sync with .github/workflows/annotations.yml and the note in .annotated-tree.toml
# (annotated-tree's config has no `ignore` key, so exclusion is done at the CALL site). The corpora's
# data files carry no recognized code extension anyway; the globs cover their migrated `.md` ledgers.
echo "pre-commit: annotated-tree --strict-check"
# Resolve annotated-tree robustly (hooks run with a minimal PATH): prefer an installed binary under
# the npm global prefix or PATH, else fall back to `npx` (fetches it on demand); fail loud otherwise.
npm_bin="${npm_config_prefix:-$HOME/.npm-global}/bin"
case ":$PATH:" in *":$npm_bin:"*) ;; *) PATH="$npm_bin:$PATH" ;; esac
export PATH
if command -v annotated-tree >/dev/null 2>&1; then
	annotated-tree --strict-check --include-tests -I 'conformance/encoding/**' -I 'conformance/formula/**' -I 'conformance/render/**' .
elif command -v npx >/dev/null 2>&1; then
	# Pinned to an exact version (load-bearing gate; `--yes annotated-tree` alone would fetch
	# LATEST and could drift --strict-check behavior). Keep in sync with
	# .github/workflows/annotations.yml. Bump both together, deliberately.
	npx --yes annotated-tree@0.2.1 --strict-check --include-tests -I 'conformance/encoding/**' -I 'conformance/formula/**' -I 'conformance/render/**' .
else
	echo "pre-commit: annotated-tree not found (install: 'npm i -g annotated-tree', or ensure npx is on PATH)" >&2
	exit 1
fi

# --- conformance BACKSLIDE state-guard -----------------------------------------------------------
# The fast checks passed. Now verify the commit introduces no FORMULA-CONFORMANCE BACKSLIDE — a
# fixture that was `Match` in the committed conformance/formula/facts-snapshot.tsv anchor and no
# longer is. `conformance backslide` does the comparison and encodes the verdict in its EXIT CODE
# (growth/improvements are exempt BY CONSTRUCTION, so they never block):
#   0 = no proven fact lost                 -> PASS
#   1 = >=1 backslide                        -> BLOCK
#   2 = anchor missing/unreadable            -> BLOCK (fail SAFE: never a false pass when unverifiable)
#   * = any other exit                       -> BLOCK (fail SAFE)
# There is deliberately NO message-based override at commit time: a pre-commit hook cannot read the
# pending commit message, so there is no `Backslide:`-trailer escape hatch here. A regression is
# resolved by fixing it OR by consciously re-blessing the baseline with
# `cargo run -p conformance -- resnapshot` (which has its own --allow-backslide guard) and committing
# the updated conformance/formula/facts-snapshot.tsv with the reason.
#
# $PRECOMMIT_BACKSLIDE_CMD is a TEST-ONLY seam (driven by pre-commit.selftest.sh): if set, it is
# called INSTEAD of the real cargo command so the self-test can stub the exit code. It is NOT a
# production knob and NOT a security boundary — like any local hook the whole check is
# `--no-verify`-class bypassable, so the seam grants nothing a bypass didn't already. cargo was
# resolved onto PATH above; git runs pre-commit with cwd = the worktree root, so
# `cargo run -p conformance` resolves the workspace directly (were that untrue, cargo would error ->
# the *) branch fails SAFE, never a false pass).
echo "pre-commit: conformance backslide guard (builds + grades the formula corpus vs the committed anchor)..."
if [ -n "${PRECOMMIT_BACKSLIDE_CMD:-}" ]; then
	if "$PRECOMMIT_BACKSLIDE_CMD"; then backslide_rc=0; else backslide_rc=$?; fi
else
	if cargo run -q -p conformance -- backslide; then backslide_rc=0; else backslide_rc=$?; fi
fi

case "$backslide_rc" in
0) : ;; # no proven fact lost — improvements and growth never block
1)
	{
		printf '\npre-commit BLOCKED: conformance BACKSLIDE — a fixture left Match (see the guard output above).\n'
		printf '\nResolve ONE of:\n'
		printf '  - fix the regression so no fixture loses its Match, OR\n'
		printf '  - if the new state is the correct baseline, re-bless it:\n'
		printf '      cargo run -p conformance -- resnapshot   (has its own --allow-backslide conscious guard)\n'
		printf '    then commit the updated conformance/formula/facts-snapshot.tsv with the reason.\n'
	} >&2
	exit 1
	;;
2)
	{
		printf '\npre-commit BLOCKED: cannot verify conformance — the facts-snapshot.tsv anchor is missing/unreadable (backslide exit 2; see the guard output above).\n'
		printf '\nFailing SAFE (never a false pass when the anchor cannot be read). Restore/commit the anchor\n'
		printf '(cargo run -p conformance -- resnapshot) so the guard has a baseline to compare against.\n'
	} >&2
	exit 1
	;;
*)
	{
		printf '\npre-commit BLOCKED: the conformance backslide guard errored (unexpected exit %s) — failing safe (see the guard output above).\n' "$backslide_rc"
	} >&2
	exit 1
	;;
esac

echo "pre-commit: OK (fmt + clippy + annotations + conformance backslide clean)"
