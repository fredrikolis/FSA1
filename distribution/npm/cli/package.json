  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "fsa1-cli-linux-x64-musl": "0.3.1",
    "fsa1-cli-linux-arm64-musl": "0.3.1",
    "fsa1-cli-darwin-x64": "0.3.1",
    "fsa1-cli-darwin-arm64": "0.3.1",
    "fsa1-cli-windows-x64": "0.3.1"
