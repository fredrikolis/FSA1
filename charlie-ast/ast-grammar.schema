# charlie-ast formula grammar (generated from the Rust types; provenance elided)
# schema-version: 1

value =
  Number(f64)
  Text(string)
  Bool(bool)
  Error(errkind)
  Array(shape, value*)
  Blank

errkind = Ref | Div0 | Value | Name | Na | Null | Num | Spill(reserved) | Calc(reserved)

expr =
  Lit(value)
  Ref(refnode)
  Range(rangenode)
  Unary(unop, expr)
  Binary(binop, expr, expr)
  Call(funcid, expr*)
  ImplicitIntersect(expr)  # reserved: @
  SpillRef(expr)  # reserved: #

unop = Plus | Neg | Percent
binop = Add | Sub | Mul | Div | Pow | Concat | Eq | Ne | Lt | Le | Gt | Ge

# operator precedence (binding power; tightest last)
precedence =
  comparisons(=,<>,<,<=,>,>=) : 10
  concat(&) : 20
  add-sub(+,-) : 30
  mul-div(*,/) : 40
  pow(^) : 50
  percent(%,postfix) : 60
  unary(-,+,prefix) : 70
  spill(#,postfix) : 80
  implicit-intersect(@,prefix) : 85
  range(:) : 90

# function registry (name : arity)
functions =
  SUM : 1+
  AVERAGE : 1+
  COUNT : 1+
  IF : 2-3
  IFERROR : 2
  AND : 1+
  OR : 1+
  ABS : 1
  ROUND : 2
  SUMIF : 2-3
  SUMIFS : 3+
  COUNTIF : 2
  COUNTIFS : 2+
  AVERAGEIF : 2-3
  AVERAGEIFS : 3+
  MINIFS : 3+
  MAXIFS : 3+
  PRODUCT : 1+
  SUMPRODUCT : 1+
  ROUNDUP : 2
  ROUNDDOWN : 2
  INT : 1
  MOD : 2
  POWER : 2
  SQRT : 1
  CEILING : 2
  FLOOR : 2
  MIN : 1+
  MAX : 1+
  MEDIAN : 1+
  RANK : 2-3
  COUNTA : 1+
  COUNTBLANK : 1
  IFS : 2+
  NOT : 1
  IFNA : 2
  SWITCH : 3+
