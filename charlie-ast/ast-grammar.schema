# charlie-ast formula grammar (generated from the Rust types; provenance elided)
# schema-version: 1

value =
  Number(f64)
  Text(string)
  Bool(bool)
  Error(errkind)
  Array(shape, value*)
  Blank

errkind = Ref | Div0 | Value | Name | Na | Null | Num | Spill(reserved) | Calc(reserved)

expr =
  Lit(value)
  Ref(refnode)
  Range(rangenode)
  Unary(unop, expr)
  Binary(binop, expr, expr)
  Call(funcid, expr*)
  ImplicitIntersect(expr)  # reserved: @
  SpillRef(expr)  # reserved: #

unop = Plus | Neg | Percent
binop = Add | Sub | Mul | Div | Pow | Concat | Eq | Ne | Lt | Le | Gt | Ge

# operator precedence (binding power; tightest last)
precedence =
  comparisons(=,<>,<,<=,>,>=) : 10
  concat(&) : 20
  add-sub(+,-) : 30
  mul-div(*,/) : 40
  pow(^) : 50
  percent(%,postfix) : 60
  unary(-,+,prefix) : 70
  spill(#,postfix) : 80
  implicit-intersect(@,prefix) : 85
  range(:) : 90

# function registry (name : arity)
functions =
  SUM : 1+
  AVERAGE : 1+
  COUNT : 1+
  IF : 2-3
  IFERROR : 2
  AND : 1+
  OR : 1+
  ABS : 1
  ROUND : 2
  SUMIF : 2-3
  SUMIFS : 3+
  COUNTIF : 2
  COUNTIFS : 2+
  AVERAGEIF : 2-3
  AVERAGEIFS : 3+
  MINIFS : 3+
  MAXIFS : 3+
  PRODUCT : 1+
  SUMPRODUCT : 1+
  ROUNDUP : 2
  ROUNDDOWN : 2
  INT : 1
  MOD : 2
  POWER : 2
  SQRT : 1
  CEILING : 2
  FLOOR : 2
  MIN : 1+
  MAX : 1+
  MEDIAN : 1+
  RANK : 2-3
  COUNTA : 1+
  COUNTBLANK : 1
  STDEV : 1+
  STDEV.S : 1+
  STDEVP : 1+
  STDEV.P : 1+
  VAR : 1+
  VAR.S : 1+
  VARP : 1+
  VAR.P : 1+
  MODE : 1+
  MODE.SNGL : 1+
  LARGE : 2
  SMALL : 2
  PERCENTILE : 2
  PERCENTILE.INC : 2
  QUARTILE : 2
  QUARTILE.INC : 2
  IFS : 2+
  NOT : 1
  IFNA : 2
  SWITCH : 3+
  CONCAT : 1+
  TEXTJOIN : 3+
  LEFT : 1-2
  RIGHT : 1-2
  MID : 3
  LEN : 1
  FIND : 2-3
  SEARCH : 2-3
  SUBSTITUTE : 3-4
  REPLACE : 4
  TRIM : 1
  UPPER : 1
  LOWER : 1
  TEXT : 2
  DATE : 3
  YEAR : 1
  MONTH : 1
  DAY : 1
  EDATE : 2
  DATEDIF : 3
  TODAY : 0
  NOW : 0
  XLOOKUP : 3-6
  INDEX : 2-3
  MATCH : 2-3
  VLOOKUP : 3-4
  CHOOSE : 2+
  ROW : 1
  COLUMN : 1
  HLOOKUP : 3-4
  LOOKUP : 2-3
  ROWS : 1
  COLUMNS : 1
  XMATCH : 2-3
  INDIRECT : 0+
  OFFSET : 0+
  ISBLANK : 1
  ISNUMBER : 1
  ISTEXT : 1
  ISERROR : 1
  NA : 0
  TYPE : 1
  PMT : 3-5
  FV : 3-5
  NPER : 3-5
  RATE : 3-6
